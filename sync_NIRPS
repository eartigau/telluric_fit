
# Sync calibration and science files for NIRPS
# Prefer the interpreter provided by run_pipeline.py; fallback to active shell python.
PYTHON="${TELLURIC_PYTHON:-}"
if [ -z "$PYTHON" ]; then
    PYTHON=$(command -v python 2>/dev/null || command -v python3 2>/dev/null)
fi
if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
    echo "ERROR: no python found"
    exit 1
fi
SRC_BASE="/scratch/eartigau/nirps_tempo"
SRC_CALIB="$SRC_BASE/calib"
SRC_OBJECTS="$SRC_BASE/objects"
SRC_TEMPLATES="$SRC_BASE/red/other"

# Resolve script directory (works regardless of where the script is invoked from)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Determine project_path from telluric_config.yaml by checking detect_path for each machine
BATCH_CONFIG="$SCRIPT_DIR/telluric_config.yaml"
if [ ! -f "$BATCH_CONFIG" ]; then
    echo "ERROR: telluric_config.yaml not found at $BATCH_CONFIG"
    exit 1
fi

PROJECT_PATH=$($PYTHON -c "
import yaml, os, sys
cfg_path = '$BATCH_CONFIG'
with open(cfg_path) as f:
    config = yaml.safe_load(f)
machines = config.get('machines', {})
for name, mc in machines.items():
    detect_path = mc.get('detect_path', '')
    if detect_path and os.path.exists(detect_path):
        print(mc.get('project_path', detect_path))
        sys.exit(0)
# No machine matched — print all candidates for diagnosis
print('ERROR: No matching machine detected. Checked detect_path for:', file=sys.stderr)
for name, mc in machines.items():
    print(f'  {name}: {mc.get(\"detect_path\", \"(none)\")}', file=sys.stderr)
print(f'None of these paths exist on this machine.', file=sys.stderr)
print(f'Add or update your machine entry in: $BATCH_CONFIG (telluric_config.yaml)', file=sys.stderr)
sys.exit(1)
")
if [ $? -ne 0 ]; then
    exit 1
fi

DST_CALIB="$PROJECT_PATH/calib_NIRPS"
DST_SCIDATA="$PROJECT_PATH/scidata_NIRPS"
DST_HOTSTARS="$PROJECT_PATH/hotstars_NIRPS"
DST_ORIG="$PROJECT_PATH/orig_NIRPS"
DST_TEMPLATES="$PROJECT_PATH/templates_NIRPS"
mkdir -p "$DST_CALIB" "$DST_SCIDATA" "$DST_HOTSTARS" "$DST_ORIG" "$DST_TEMPLATES"

echo ""
echo "========================================"
echo "  sync_NIRPS"
echo "  Source calib   : $SRC_CALIB"
echo "  Source objects : $SRC_OBJECTS"
echo "  Project path   : $PROJECT_PATH"
echo "  Destination folders:"
echo "    calibrations -> $DST_CALIB"
echo "    science      -> $DST_SCIDATA"
echo "    hotstars     -> $DST_HOTSTARS"
echo "    t.fits       -> $DST_ORIG"
echo "========================================"
echo ""

# Copy calibration files using find (faster than rsync with include/exclude on large Lustre dirs)
echo ""
echo "[1/3] Calibrations"
echo "  FROM : $SRC_CALIB"
echo "  TO   : $DST_CALIB"
echo "  Patterns : wave_fplines, wave_hclines, wavesol_ref, waveref_hclines, wave_night"
find "$SRC_CALIB" -maxdepth 2 -type f \( \
  -name '*wave_fplines_A.fits' -o \
  -name '*wave_hclines_A.fits' -o \
  -name '*wavesol_ref_A.fits' -o \
  -name '*waveref_hclines*A.fits' -o \
  -name '*_e2dsff_A_wave_night_A.fits' \
\) -exec cp -u {} "$DST_CALIB/" \;
echo "[1/3] Calibrations OK -> $DST_CALIB"
echo ""

# Sync science objects — only targets listed under science_targets in the YAML
echo ""
echo "[2/3] Loading science_targets from telluric_config.yaml..."
SCIENCE_TARGETS=($($PYTHON -c "
import yaml, os
cfg = yaml.safe_load(open(os.path.join(os.path.dirname(os.path.abspath('$0')), 'telluric_config.yaml')))
targets = sorted({t for info in cfg.get('data_recipients', {}).values() for t in (info if isinstance(info, list) else info.get('targets', []))})
print(' '.join(targets))
"))

if [ ${#SCIENCE_TARGETS[@]} -eq 0 ]; then
    echo "  Warning: no targets in science_targets in the YAML, no science objects will be synced."
else
    echo "[2/3] ${#SCIENCE_TARGETS[@]} target(s): ${SCIENCE_TARGETS[*]}"
    for target in "${SCIENCE_TARGETS[@]}"; do
        mkdir -p "$DST_SCIDATA/$target"
        mkdir -p "$DST_ORIG/$target"
        if [ -d "$SRC_OBJECTS/$target" ]; then
            N_E2DS=$(ls "$SRC_OBJECTS/$target/"*_e2dsff_A.fits 2>/dev/null | wc -l | tr -d ' ')
            N_TFITS=$(ls "$SRC_OBJECTS/$target/"*t.fits 2>/dev/null | wc -l | tr -d ' ')
            echo "  -> $target"
            echo "     FROM (e2dsff) : $SRC_OBJECTS/$target/  [${N_E2DS} fichiers]"
            echo "     TO   (e2dsff) : $DST_SCIDATA/$target/"
            rsync -av --progress "$SRC_OBJECTS/$target/"*_e2dsff_A.fits "$DST_SCIDATA/$target/" 2>/dev/null || true
            echo "     FROM (t.fits) : $SRC_OBJECTS/$target/  [${N_TFITS} fichiers]"
            echo "     TO   (t.fits) : $DST_ORIG/$target/"
            rsync -av --progress "$SRC_OBJECTS/$target/"*t.fits "$DST_ORIG/$target/" 2>/dev/null || true
        else
            echo "  Warning: $target not found in $SRC_OBJECTS"
        fi
    done
fi
echo "[2/3] Science objects OK"
echo ""

# Copy hotstars (flattened - no subdirectories)
echo ""
echo "[3/3] Loading hot_stars from telluric_config.yaml..."
HOT_STARS=($($PYTHON -c "
import yaml, os
cfg = yaml.safe_load(open(os.path.join(os.path.dirname(os.path.abspath('$0')), 'telluric_config.yaml')))
print(' '.join(cfg.get('hot_stars', [])))
"))

echo "[3/3] ${#HOT_STARS[@]} telluric star(s): ${HOT_STARS[*]}"
for star in "${HOT_STARS[@]}"; do
    if [ -d "$SRC_OBJECTS/$star" ]; then
        N_E2DS=$(ls "$SRC_OBJECTS/$star/"*_e2dsff_A.fits 2>/dev/null | wc -l | tr -d ' ')
        echo "  -> $star"
        echo "     FROM : $SRC_OBJECTS/$star/  [${N_E2DS} fichiers]"
        echo "     TO   : $DST_HOTSTARS"
        rsync -av --progress "$SRC_OBJECTS/$star/"*_e2dsff_A.fits "$DST_HOTSTARS" 2>/dev/null || true
    else
        echo "  Warning: $star not found in $SRC_OBJECTS"
    fi
done
echo "[3/3] Telluric stars OK"

# Sync stellar templates for science targets
echo ""
echo "[4/4] Syncing stellar templates from $SRC_TEMPLATES"
for target in "${SCIENCE_TARGETS[@]}"; do
    TEMPLATE_FILE="Template_s1dv_${target}_sc1d_v_file_A.fits"
    if [ -f "$SRC_TEMPLATES/$TEMPLATE_FILE" ]; then
        echo "  -> $target : $TEMPLATE_FILE"
        rsync -av --progress "$SRC_TEMPLATES/$TEMPLATE_FILE" "$DST_TEMPLATES/" 2>/dev/null || true
    else
        echo "  (no template for $target in $SRC_TEMPLATES)"
    fi
done
echo "[4/4] Templates OK"

echo ""
echo "========================================"
echo "  sync_NIRPS done."
echo "========================================"  