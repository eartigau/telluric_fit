
# Synchronisation des fichiers FP et HC pour NIRPS
SRC_BASE="/scratch/eartigau/nirps_tempo"
SRC_CALIB="$SRC_BASE/calib"
SRC_OBJECTS="$SRC_BASE/objects"
DST_CALIB="calib_NIRPS"
DST_SCIDATA="scidata_NIRPS"
DST_HOTSTARS="hotstars_NIRPS"
DST_ORIG="orig_NIRPS"
mkdir -p "$DST_CALIB" "$DST_SCIDATA" "$DST_HOTSTARS" "$DST_ORIG"

echo ""
echo "========================================"
echo "  sync_NIRPS"
echo "  Source calib   : $SRC_CALIB"
echo "  Source objects : $SRC_OBJECTS"
echo "  Dest           : $(pwd)"
echo "  Dossiers cibles:"
echo "    calibrations -> $DST_CALIB"
echo "    science      -> $DST_SCIDATA"
echo "    hotstars     -> $DST_HOTSTARS"
echo "    t.fits       -> $DST_ORIG"
echo "========================================"
echo ""

# Synchroniser tous les fichiers de calibration nécessaires
# (--include/--exclude : rsync gère le matching, pas le shell — compatible SSH)
echo ""
echo "[1/3] Calibrations -> $DST_CALIB"
echo "  Patterns : wave_fplines, wave_hclines, wavesol_ref, waveref_hclines, wave_night"
rsync -av --progress \
  --include='*/'\
  --include='*wave_fplines_A.fits' \
  --include='*wave_hclines_A.fits' \
  --include='*wavesol_ref_A.fits' \
  --include='*waveref_hclines*A.fits' \
  --include='*_e2dsff_A_wave_night_A.fits' \
  --exclude='*' \
  "$SRC_CALIB/" "$DST_CALIB"
echo "[1/3] Calibrations OK"
echo ""

# Sync science objects — uniquement les cibles listées dans science_targets du YAML
echo ""
echo "[2/3] Chargement de science_targets depuis telluric_config.yaml..."
SCIENCE_TARGETS=($(python3 -c "
import yaml, os
cfg = yaml.safe_load(open(os.path.join(os.path.dirname(os.path.abspath('$0')), 'telluric_config.yaml')))
print(' '.join(cfg.get('science_targets', [])))
"))

if [ ${#SCIENCE_TARGETS[@]} -eq 0 ]; then
    echo "  Attention : aucune cible dans science_targets du YAML, aucun objet scientifique synchronisé."
else
    echo "[2/3] ${#SCIENCE_TARGETS[@]} cible(s) : ${SCIENCE_TARGETS[*]}"
    for target in "${SCIENCE_TARGETS[@]}"; do
        if [ -d "$SRC_OBJECTS/$target" ]; then
            N_E2DS=$(ls "$SRC_OBJECTS/$target/"*_e2dsff_A.fits 2>/dev/null | wc -l | tr -d ' ')
            N_TFITS=$(ls "$SRC_OBJECTS/$target/"*t.fits 2>/dev/null | wc -l | tr -d ' ')
            echo "  -> $target  (${N_E2DS} e2dsff, ${N_TFITS} t.fits disponibles à la source)"
            mkdir -p "$DST_SCIDATA/$target"
            echo "     Copie e2dsff -> $DST_SCIDATA/$target/"
            rsync -av --progress "$SRC_OBJECTS/$target/"*_e2dsff_A.fits "$DST_SCIDATA/$target/" 2>/dev/null || true
            mkdir -p "$DST_ORIG/$target"
            echo "     Copie t.fits -> $DST_ORIG/$target/"
            rsync -av --progress "$SRC_OBJECTS/$target/"*t.fits "$DST_ORIG/$target/" 2>/dev/null || true
        else
            echo "  Avertissement : $target introuvable dans $SRC_OBJECTS"
        fi
    done
fi
echo "[2/3] Objets science OK"
echo ""

# Copy hotstars (flattened - no subdirectories)
echo ""
echo "[3/3] Chargement de hot_stars depuis telluric_config.yaml..."
HOT_STARS=($(python3 -c "
import yaml, os
cfg = yaml.safe_load(open(os.path.join(os.path.dirname(os.path.abspath('$0')), 'telluric_config.yaml')))
print(' '.join(cfg.get('hot_stars', [])))
"))

echo "[3/3] ${#HOT_STARS[@]} étoile(s) tellurique(s) : ${HOT_STARS[*]}"
for star in "${HOT_STARS[@]}"; do
    if [ -d "$SRC_OBJECTS/$star" ]; then
        N_E2DS=$(ls "$SRC_OBJECTS/$star/"*_e2dsff_A.fits 2>/dev/null | wc -l | tr -d ' ')
        echo "  -> $star  (${N_E2DS} e2dsff disponibles à la source)"
        echo "     Copie e2dsff -> $DST_HOTSTARS"
        rsync -av --progress "$SRC_OBJECTS/$star/"*_e2dsff_A.fits "$DST_HOTSTARS" 2>/dev/null || true
    else
        echo "  Avertissement : $star introuvable dans $SRC_OBJECTS"
    fi
done
echo "[3/3] Étoiles telluriques OK"

echo ""
echo "========================================"
echo "  sync_NIRPS terminé."
echo "========================================" 