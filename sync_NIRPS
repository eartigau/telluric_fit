
# Synchronisation des fichiers FP et HC pour NIRPS
SRC_BASE="/scratch/eartigau/nirps_tempo"
SRC_CALIB="$SRC_BASE/calib"
SRC_OBJECTS="$SRC_BASE/objects"
DST_CALIB="calib_NIRPS/"
DST_SCIDATA="scidata_NIRPS/"
DST_HOTSTARS="hotstars_NIRPS/"
mkdir -p "$DST_CALIB" "$DST_SCIDATA" "$DST_HOTSTARS"

# Synchroniser les fichiers FP (Fabry-Perot)
rsync -av "$SRC_CALIB"/*wave_fplines_A.fits "$DST_CALIB"

# Synchroniser les fichiers HC (Hollow Cathode)
rsync -av "$SRC_CALIB"/*wave_hclines_A.fits "$DST_CALIB"

# Synchroniser les fichiers de référence
rsync -av "$SRC_CALIB"/*wavesol_ref_A.fits "$DST_CALIB"
rsync -av "$SRC_CALIB"/*waveref_hclines*A.fits "$DST_CALIB"

# Synchroniser les fichiers night wave
rsync -av "$SRC_CALIB"/*_e2dsff_A_wave_night_A.fits "$DST_CALIB"

# Sync science objects
rsync -av \
  --include='*/' \
  --include='**/*_e2dsff_A.fits' \
  --exclude='*' \
  "$SRC_OBJECTS/" \
  "$DST_SCIDATA"

# Copy hotstars (flattened - no subdirectories)
# Hot star list from telluric_config.yaml
HOT_STARS=(15PEG 17PEG 23LMI 24LYN 31CAS 33LYN 51DRA 59PEG 74PSCB 82UMA \
           BETSER CHICAP ETAPYX GAMSCT GAMTRI HD130917 HD159170 HD195094 \
           HR1314 HR1832 HR1903 HR2180 HR2209 HR3117 HR3131 HR3314 HR4023 \
           HR4467 HR4468 HR4687 HR4722 HR4889 HR5107 HR5671 HR6025 HR6743 \
           HR7590 HR7830 HR806 HR8489 HR8709 HR9098 IOTCYG LLEO OMICAPA \
           PHILEO PI02ORI ZETLEP ZETVIR)

for star in "${HOT_STARS[@]}"; do
    if [ -d "$SRC_OBJECTS/$star" ]; then
        echo "Copying $star..."
        rsync -av "$SRC_OBJECTS/$star/"*_e2dsff_A.fits "$DST_HOTSTARS" 2>/dev/null || true
    fi
done

echo "Done syncing hot stars to $DST"