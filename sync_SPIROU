
# Synchronisation des fichiers FP et HC pour SPIROU
SRC_BASE="/scratch/eartigau/spirou_tempo"
SRC_CALIB="$SRC_BASE/calib"
SRC_OBJECTS="$SRC_BASE/objects"
DST_CALIB="calib_SPIROU/"
DST_SCIDATA="scidata_SPIROU/"
DST_HOTSTARS="hotstars_SPIROU/"
mkdir -p "$DST_CALIB" "$DST_SCIDATA" "$DST_HOTSTARS"

# Synchroniser les fichiers FP (Fabry-Perot)
rsync -av "$SRC_CALIB"/*wave_fplines_AB.fits "$DST_CALIB"

# Synchroniser les fichiers HC (Hollow Cathode)
rsync -av "$SRC_CALIB"/*wave_hclines_AB.fits "$DST_CALIB"

# Synchroniser les fichiers de référence
rsync -av "$SRC_CALIB"/*wavesol_ref_AB.fits "$DST_CALIB"
rsync -av "$SRC_CALIB"/*waveref_hclines*AB.fits "$DST_CALIB"

# Synchroniser les fichiers night wave
rsync -av "$SRC_CALIB"/*_e2dsff_AB_wave_night_AB.fits "$DST_CALIB"

# Sync science objects — uniquement les cibles listées dans science_targets du YAML
SCIENCE_TARGETS=($(python3 -c "
import yaml, os
cfg = yaml.safe_load(open(os.path.join(os.path.dirname(os.path.abspath('$0')), 'telluric_config.yaml')))
print(' '.join(cfg.get('science_targets', [])))
"))

if [ ${#SCIENCE_TARGETS[@]} -eq 0 ]; then
    echo "Attention : aucune cible dans science_targets du YAML, aucun objet scientifique synchronisé."
else
    echo "Cibles scientifiques à synchroniser : ${SCIENCE_TARGETS[*]}"
    for target in "${SCIENCE_TARGETS[@]}"; do
        if [ -d "$SRC_OBJECTS/$target" ]; then
            echo "Syncing $target..."
            mkdir -p "$DST_SCIDATA/$target"
            rsync -av "$SRC_OBJECTS/$target/"*_e2dsff_AB.fits "$DST_SCIDATA/$target/" 2>/dev/null || true
        else
            echo "Avertissement : $target introuvable dans $SRC_OBJECTS"
        fi
    done
fi

# Copy hotstars (flattened - no subdirectories)
# Hot star list from telluric_config.yaml
HOT_STARS=($(python3 -c "
import yaml, os
cfg = yaml.safe_load(open(os.path.join(os.path.dirname(os.path.abspath('$0')), 'telluric_config.yaml')))
print(' '.join(cfg.get('hot_stars', [])))
"))

for star in "${HOT_STARS[@]}"; do
    if [ -d "$SRC_OBJECTS/$star" ]; then
        echo "Copying $star..."
        rsync -av "$SRC_OBJECTS/$star/"*_e2dsff_AB.fits "$DST_HOTSTARS" 2>/dev/null || true
    fi
done

echo "Done syncing SPIROU."
